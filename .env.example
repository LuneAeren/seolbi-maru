# Copy to .env only inside the approved environment. Never commit .env.
APP_MODE=demo
HOST=127.0.0.1
PORT=4317
PUBLIC_ORIGIN=http://127.0.0.1:4317
# Default is data/demo.sqlite or data/production.sqlite according to APP_MODE.
# DATA_FILE=data/demo.sqlite
STALE_AFTER_MINUTES=30
# Production only: values must be provided by the internal authentication owner.
AUTH_PROXY_SECRET=
DEPARTMENT_USERS=
AUTH_PROXY_IPS=127.0.0.1,::ffff:127.0.0.1,::1
# Exact host[:port] entries, comma-separated. Empty allows only relative links.
ALLOWED_SITE_HOSTS=

# Optional integration reference, demo only. Default is read-only + viewer.
REFERENCE_SERVICE_WRITE=0
REFERENCE_SERVICE_ROLES={}
# Demo exercise only: REFERENCE_SERVICE_ROLES={"demo-engineer":"assigner"}
