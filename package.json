{
  "name": "seolbi-maru",
  "version": "0.2.0",
  "private": true,
  "description": "Express-based offline intranet portal for equipment engineers",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check-source.js",
    "fixtures": "node scripts/make-fixtures.js"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
